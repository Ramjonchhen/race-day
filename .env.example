# Node Environment: To Distinguish between Development / Production & Test Environment 
# three values: development/production/test for the appropriate environment 
# In .env.example, it is explicitly configured to development
# as we clone mostly on local dev setup, on real production set it to: production
NODE_ENV=development
# HTTP SERVER START PORT
PORT=3000 
# Database ENV variable, use the same configs as we provided to Docker
# Database host example for local dev is set as localhost; for production set accordingly
DATABASE_HOST=localhost
DATABASE_NAME=raceday
DATABASE_USER=raceday
DATABASE_PASSWORD=race-day-db-password
DATABASE_PORT=5432